# Скопируйте в deploy/.env и заполните. Файл .env НЕ коммитить (chmod 600).
DOMAIN=reports.adata.kz
ACME_EMAIL=devops@adata.kz
TZ=Asia/Almaty

POSTGRES_PASSWORD=change-me-long-random

# Сессии: openssl rand -hex 32
SESSION_SECRET=
# Telegram ID первых администраторов через запятую
ADMIN_TG_IDS=

# Jira Server/DC: сервисный пользователь, Profile → Personal Access Tokens
JIRA_BASE_URL=https://jira.adata.kz
JIRA_PAT=
JIRA_SYNC_EVERY=30m
JIRA_FULL_SYNC_AT=03:00

# Bitrix: свой API отпусков (GET ?id=<табельный ID>&api_key=<ключ>). Ключ — секрет, в логах маскируется.
BITRIX_VACATION_URL=https://bitrix.avh.kz/api/v1/vacation_api.php
BITRIX_API_KEY=
BITRIX_SYNC_EVERY=30m

# Telegram-бот (BotFather). Privacy mode: Disable. Добавить в группу админом.
TG_BOT_TOKEN=
TG_BOT_USERNAME=adata_reports_bot
# openssl rand -hex 24 — проверяется в заголовке X-Telegram-Bot-Api-Secret-Token
TG_WEBHOOK_SECRET=
# ID группы «Adata Group» (отрицательное число, -100…)
TG_CHAT_ID=

# Бэкапы
BACKUP_DIR=/var/backups/adata-reports
BACKUP_AGE_RECIPIENT=
