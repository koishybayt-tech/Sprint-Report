# Доступ к локально поднятому сервису из офисной сети: http://<IP компьютера>/ с общим логином и паролем.
# Временная мера до входа через Telegram. Логин и bcrypt-хеш пароля — в deploy/.env (LAN_USER, LAN_PASSWORD_HASH).
{
	auto_https off
}

:80 {
	basic_auth {
		{$LAN_USER} {$LAN_PASSWORD_HASH}
	}
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}
	handle /api/* {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy web:3000
	}
}
