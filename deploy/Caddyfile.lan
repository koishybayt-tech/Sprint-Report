# Доступ к локально поднятому сервису из офисной сети: http://<IP компьютера>/.
# Вход — логин и пароль пользователя самого сервиса (страница /login); api и web наружу не открыты.
{
	auto_https off
}

:80 {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}
	handle /api/* {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy web:3000
	}
}
